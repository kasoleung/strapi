{
  "kind": "collectionType",
  "collectionName": "banners",
  "info": {
    "singularName": "banner",
    "pluralName": "banners",
    "displayName": "Banner"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "linkType": {
      "type": "enumeration",
      "enum": ["event", "external", "none"],
      "default": "none"
    },
    "externalUrl": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "gradientStart": {
      "type": "string"
    },
    "gradientEnd": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false
    },
    "event": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event"
    }
  }
}
